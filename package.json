{
  "name": "exoatlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:all": "npm test && npm run test:db && npm run test:e2e",
    "e2e:install": "playwright install chromium",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-on-deploy": "tsx scripts/migrate-on-deploy.ts",
    "db:readonly-role": "tsx scripts/create-readonly-role.ts",
    "deploy:rollback": "tsx scripts/rollback-production.ts",
    "sync": "tsx --env-file-if-exists=.env.local scripts/sync.ts",
    "seed:sol": "tsx --env-file-if-exists=.env.local scripts/seed-solar-system.ts",
    "textures": "tsx scripts/fetch-textures.ts",
    "docs:screenshots": "tsx scripts/docs-screenshots.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
